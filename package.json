{
  "$schema": "https://www.schemastore.org/package.json",
  "name": "dojo",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.3.14",
  "workspaces": {
    "packages": [
      "packages/*"
    ],
    "catalog": {
      "@effect/platform-bun": "4.0.0-rc.108",
      "@effect/platform-node": "4.0.0-rc.108",
      "effect": "4.0.0-rc.108",
      "foldkit": "0.145.0"
    },
    "catalogs": {
      "dev": {
        "@effect/language-service": "0.87.2",
        "@effect/vitest": "4.0.0-rc.108",
        "@foldkit/oxlint-plugin": "0.6.0",
        "@foldkit/vite-plugin": "0.13.1",
        "@types/bun": "1.3.14",
        "@types/node": "26.2.0",
        "electron": "43.4.0",
        "electron-builder": "26.15.3",
        "electron-builder-squirrel-windows": "26.15.3",
        "oxlint": "1.78.0",
        "oxlint-tsgolint": "7.0.2001",
        "typescript": "7.0.2",
        "vite": "8.2.1",
        "vite-plugin-pwa": "1.3.0",
        "vitest": "4.1.10"
      }
    }
  },
  "scripts": {
    "dev": "bun run scripts/dev.ts",
    "dev:web": "bun run --cwd packages/app dev",
    "build": "bun run --cwd packages/app build && bun run --cwd packages/desktop build",
    "package": "bun run build && bun run --cwd packages/desktop package",
    "test": "bun run --cwd packages/shared test && bun run --cwd packages/app test",
    "test:e2e": "bun run build && playwright test",
    "typecheck": "bun run --cwd packages/shared typecheck && bun run --cwd packages/app typecheck && bun run --cwd packages/desktop typecheck && tsc --noEmit -p scripts/tsconfig.json && tsc --noEmit -p e2e/tsconfig.json",
    "lint": "oxlint --type-aware --type-check --report-unused-disable-directives .",
    "check": "bun run typecheck && bun run lint && bun run test && bun run build"
  },
  "dependencies": {
    "@effect/platform-bun": "catalog:",
    "effect": "catalog:"
  },
  "devDependencies": {
    "@foldkit/devtools-mcp": "0.15.0",
    "@foldkit/oxlint-plugin": "catalog:dev",
    "@playwright/test": "1.62.1",
    "@types/bun": "catalog:dev",
    "@types/node": "catalog:dev",
    "chrome-devtools-mcp": "1.7.0",
    "oxlint": "catalog:dev",
    "oxlint-tsgolint": "catalog:dev",
    "typescript": "catalog:dev"
  },
  "engines": {
    "bun": ">=1.3.14"
  },
  "overrides": {
    "@effect/platform-node-shared": "4.0.0-rc.108"
  },
  "trustedDependencies": [
    "electron"
  ]
}
